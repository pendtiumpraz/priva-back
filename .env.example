APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ═════════════════════════════════════════════════════════════════════
# Frontend OTA updates (/system-update "Update Frontend" button)
# ═════════════════════════════════════════════════════════════════════
# Mode: "shell" (same-server git pull + npm build + reload) or "webhook"
# (POST a deploy hook URL — e.g. Vercel, Netlify, GitHub dispatch).
FRONTEND_DEPLOY_MODE=shell

# --- Shell mode only ---
# Absolute path to the frontend git checkout
FRONTEND_PATH=/var/www/nexus-frontend
# Absolute path to npm/node binaries. Leave empty if already in the
# PHP-FPM user's PATH. Set when using nvm or a non-system Node install.
NPM_BIN=
NODE_BIN=
# Command the PHP-FPM user can run to reload the Next.js process
# after build. Examples:
#   pm2 reload nexus-frontend
#   systemctl --user restart nexus-frontend
#   docker compose restart frontend
FRONTEND_RELOAD_CMD=

# --- Webhook mode only ---
# Vercel Deploy Hook URL, Netlify build hook, GitHub workflow_dispatch,
# or a self-hosted webhook endpoint (e.g., adnanh/webhook) on the
# frontend server.
FRONTEND_DEPLOY_HOOK_URL=
# Optional HTTP verb (POST default) — some webhooks only accept GET.
FRONTEND_DEPLOY_HOOK_METHOD=POST
# Optional auth header. Leave empty to skip auth.
FRONTEND_DEPLOY_HOOK_HEADER=X-Deploy-Secret
FRONTEND_DEPLOY_HOOK_SECRET=

# ===================================
# CORS allowlist (security)
# ===================================
# Comma-separated list of frontend origins yang boleh manggil API.
# Format: schema + host (+ optional port), tanpa trailing slash.
#
# Per-deployment value (SaaS / on-prem masing-masing punya domain sendiri):
#   - SaaS Privasimu:  https://nexus.privasimu.com,https://privasimu.sainskerta.net
#   - On-prem klien A: https://privacy.client-a.example.com
#
# Migration first-boot bakal seed dari env ini. Setelah itu, UI
# /platform-admin/system-settings → Security → CORS jadi source of truth.
CORS_ALLOWED_ORIGINS=

# Set true untuk strip localhost dev origins dari seed (production-strict).
# Default: false — localhost tetap di-allow supaya dev convenience.
CORS_ALLOWED_ORIGINS_NO_LOCALHOST=false

# Rendering PDF/DOCX untuk ROPA/DPIA telah dipindah ke frontend
# (Next.js + @react-pdf/renderer + docx). Backend hanya menyajikan
# data JSON dan tetap mendukung DOCX template upload pengguna
# (legacy) melalui DocxTemplateService.

# ===================================
# Embedding / RAG — model & penyimpanan artefak
# ===================================
# Master switch untuk seluruh fitur embedding (semantic search, similar
# record, indexing). Default off supaya boot tanpa sidecar tidak crash.
AI_EMBEDDING_ENABLED=false

# Mode penyajian model — diatur root lewat Platform Config → Model Embedding.
# Nilai di sini hanya default awal; app_settings yang menang setelah diubah.
#   local = berkas ada di disk VPS, dibaca sidecar ONNX di host yang sama
#   blob  = berkas ada di Vercel Blob, diunduh sidecar saat start (DEFAULT)
#   api   = tanpa artefak lokal; pakai provider cloud di AI_EMBEDDING_PROVIDER
AI_EMBEDDING_MODE=blob

# Model awal dari katalog config/embedding_models.php:
#   minilm-l6-v2           ~23 MB   384d  paling kecil & cepat, English
#   bge-small-en-v15       ~33 MB   384d  retrieval English lebih baik
#   multilingual-e5-small ~118 MB   384d  100+ bahasa termasuk Indonesia
AI_EMBEDDING_ACTIVE_MODEL=minilm-l6-v2

# Direktori artefak di VPS. HARUS sama dengan direktori yang di-mount ke
# /models pada container sidecar embed-onnx. Di docker/docker-compose.onprem.yml
# keduanya sudah disatukan lewat volume embed_models.
AI_EMBEDDING_MODELS_DIR=

# Alamat sidecar ONNX (docker/embed-onnx). Di dalam compose pakai nama service:
# http://embed-onnx:8091
AI_EMBEDDING_LOCAL_URL=http://127.0.0.1:8091

# Token Vercel Blob untuk menyimpan artefak model. Vercel memberi awalan nama
# store pada token yang diterbitkannya — pada deployment ini `priva`. Nama
# baku BLOB_READ_WRITE_TOKEN dipakai sebagai cadangan.
priva_READ_WRITE_TOKEN=

# Dipakai hanya saat AI_EMBEDDING_MODE=api.
AI_EMBEDDING_PROVIDER=tei
